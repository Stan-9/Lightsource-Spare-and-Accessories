rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: public read (storefront), authenticated write (admin only).
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Orders:
    //   - Anyone can CREATE (unauthenticated online checkout submits orders).
    //   - Only authenticated admins can READ, UPDATE, or DELETE.
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Settings: public read (storefront fetches shop name / WhatsApp number),
    //           authenticated write (admin panel only).
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Procurement: Admin only access for suppliers, carriers, POs, shipments, receipts, stock movements.
    match /suppliers/{id} {
      allow read, write: if request.auth != null;
    }

    match /carriers/{id} {
      allow read, write: if request.auth != null;
    }

    match /purchaseOrders/{id} {
      allow read, write: if request.auth != null;
    }

    match /purchaseLines/{id} {
      allow read, write: if request.auth != null;
    }

    match /shipments/{id} {
      allow read, write: if request.auth != null;
    }

    match /receipts/{id} {
      allow read, write: if request.auth != null;
    }

    match /receiptLines/{id} {
      allow read, write: if request.auth != null;
    }

    match /stockMovements/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
